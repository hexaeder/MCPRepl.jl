    "inspect interactively if they fail, instead of re-running a cold script). "
    "Call `usage_instructions` before first use.")


def is_private(repl):
    """True if a registry record is a private (agent-spawned, pool-hidden) REPL."""
    return bool(repl.get("private"))


def owned_by_me(repl):
    """True if this record is a private REPL *this* adapter spawned and still owns.

    Private REPLs are excluded from the auto-routing pool, but their owner should
    still be able to *discover* them (see them in list_repls, re-select them after
    a context reset) — hence this liveness-scoped ownership check. A persist REPL
    (owner_pid 0) or one owned by another session is not "mine" for listing.
    """
    return is_private(repl) and repl.get("owner_pid") == os.getpid()


# Subdir names that say nothing about *which* project a REPL belongs to; when a
# project resolves to one of these we fold in the parent directory so the tmux
# session reads e.g. `NetworkDynamics-test` rather than a bare `test`.
_GENERIC_DIRS = {"test", "tests", "docs", "doc", "src", "examples", "example",
                 "benchmark", "benchmarks", "dev"}


def session_label(proj_dir):
    """A tmux-safe, human-informative label for a project directory.

    tmux session names can't contain '.' or ':' (target syntax), so we squash
    everything outside [A-Za-z0-9_-] to '_'. Generic leaf names borrow their
    parent for context.
    """
    proj_dir = proj_dir.rstrip(os.sep)
    base = os.path.basename(proj_dir)
    if base.lower() in _GENERIC_DIRS:
        parent = os.path.basename(os.path.dirname(proj_dir))
        if parent:
            base = parent + "-" + base
    return re.sub(r"[^A-Za-z0-9_-]", "_", base) or "repl"


def session_name(token, label=None):
    """tmux session name for a spawn token, optionally with a project label.

    The labeled form (`mcprepl-<label>-<token>`) is what new spawns create and
    record; the bare form (`mcprepl-<token>`) is the fallback for records that
    predate the recorded `tmux_session` field."""
    if label:
        return SESSION_PREFIX + label + "-" + token
    return SESSION_PREFIX + token


def record_session(repl):
    """The tmux session name for a private REPL record.

    Prefer the name the spawn recorded; fall back to re-deriving the bare form
    from the token for older records that never stored one."""
    recorded = repl.get("tmux_session")
    if recorded:
        return recorded
    token = repl.get("spawn_token", "")
    return session_name(token) if token else None


def run_tmux(args):
    """Run `tmux <args>`; return (rc, stdout, stderr). Isolated for testing."""
    try:
        p = subprocess.run(["tmux"] + list(args), capture_output=True, text=True)
        return p.returncode, p.stdout, p.stderr
    except FileNotFoundError:
        return 127, "", "tmux not found"
    except Exception as e:  # pragma: no cover - defensive
        return 1, "", str(e)


# --- Registry discovery ------------------------------------------------------

def pid_alive(pid):
    """True if a process with this pid exists (best-effort, POSIX)."""
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True  # exists but not ours
    except Exception:
        return False
    return True


def read_registry():
    """Return the list of live REPL records, pruning dead ones."""
    repls = []
    for path in glob.glob(os.path.join(REGISTRY_DIR, "*.json")):
        try:
            with open(path) as fh:
                data = json.load(fh)
        except Exception:
            continue
        pid = data.get("pid")
        if not isinstance(pid, int) or not pid_alive(pid):
            continue
        repls.append(data)
    return repls


def git_root(startdir):
    """Nearest enclosing git project of startdir, stopping *before* ~.

    Returns the directory containing `.git`, or "" if none is found below the
    home directory. Mirrors `_git_root` on the Julia side.
    """
    try:
        d = os.path.realpath(startdir)
        home = os.path.realpath(os.path.expanduser("~"))
    except Exception:
        return ""
    while True:
        if d == home:
            return ""
        if os.path.exists(os.path.join(d, ".git")):
            return d
        parent = os.path.dirname(d)
        if parent == d:
            return ""
        d = parent


def safe_realpath(p):
    """os.path.realpath that never raises and treats "" as "" (not cwd)."""
    if not p:
        return ""
    try:
        return os.path.realpath(p)
    except Exception:
        return p


def dir_rank(project_dir, cwd):
    """Directory distance from cwd up to project_dir.

    0  -> same directory
    k  -> project_dir is the k-th ancestor of cwd (nearer = smaller)
    INF -> project_dir is not an ancestor of cwd (fallback-only candidate)
    """
    try:
        project_dir = os.path.realpath(project_dir)
        cwd = os.path.realpath(cwd)
    except Exception:
        return INF
    if project_dir == cwd:
        return 0
    prefix = project_dir.rstrip(os.sep) + os.sep
    if not cwd.startswith(prefix):
        return INF
    return cwd[len(prefix):].count(os.sep) + 1


# --- Talking to a REPL -------------------------------------------------------

def post_to_repl(port, request, timeout=None):
    """Forward a JSON-RPC request to a REPL's HTTP server; return parsed reply.

    With the default `timeout=None` we wait as long as the eval runs; the client
    decides when a call has taken too long and can cancel it.
    """
    data = json.dumps(request).encode("utf-8")
    req = urllib.request.Request(
        "http://127.0.0.1:%d" % port,
        data=data,
        headers={"Content-Type": "application/json"},
    )
    with urllib.request.urlopen(req, timeout=timeout) as response:
        body = response.read().decode("utf-8")
    return json.loads(body) if body.strip() else None


# --- JSON-RPC framing helpers ------------------------------------------------

def emit(obj):
    """Write one JSON-RPC message to stdout (thread-safe)."""
    with _EMIT_LOCK:
        print(json.dumps(obj), flush=True)


def error_result(request_id, message, code=-32603):
    return {"jsonrpc": "2.0", "id": request_id,
            "error": {"code": code, "message": message}}


def tool_text_result(request_id, text):
    """A successful tools/call result carrying a plain-text body."""
    return {"jsonrpc": "2.0", "id": request_id,
            "result": {"content": [{"type": "text", "text": text}]}}


