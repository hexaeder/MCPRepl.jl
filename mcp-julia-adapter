# --- Private (agent-spawned) REPLs -------------------------------------------
# An agent with no REPL can spawn its own *private* one via the `spawn_repl`
# tool: a real interactive Julia REPL running inside a detached tmux session, so
# it behaves exactly like a shared REPL from Julia's side but is hidden from the
# routing pool and reachable only by explicit word-id. Sessions are named
# `mcprepl-<token>`; we remember the ones we spawned so we can kill them when
# this adapter (i.e. the client session) exits.
SESSION_PREFIX = "mcprepl-"
SPAWNED_SESSIONS = set()     # tmux session names spawned by *this* adapter
SPAWN_TIMEOUT = 180.0        # seconds to wait for a spawned REPL to register
SPAWN_POLL = 0.5             # poll interval while waiting

# --- Concurrency: keep the stdin reader responsive during a long eval ---------
# A routed tools/call (exec_repl) blocks on Julia's HTTP response for as long as
# the code runs. If we did that on the reader thread, the client's
# notifications/cancelled (Esc) would sit unread in our stdin pipe until the eval
# finished — never interrupting it. So we forward routed calls on worker threads
# and keep reading stdin. `_EMIT_LOCK` serializes stdout writes across threads;
# `_INFLIGHT` maps a request id to the REPL port handling it, so a cancellation
# can post an `interrupt` to that REPL; `_PORT_LOCKS` serializes evals per REPL
# (one backend, one global stdout redirect) so concurrent calls can't interleave.
_EMIT_LOCK = threading.Lock()
_INFLIGHT = {}               # request id -> port currently serving it
_INFLIGHT_LOCK = threading.Lock()
_PORT_LOCKS = {}             # port -> Lock serializing that REPL's evals
_PORT_LOCKS_GUARD = threading.Lock()
_WORKERS = set()             # live forward-worker threads, for graceful drain
_WORKERS_GUARD = threading.Lock()
DRAIN_TIMEOUT = 10.0         # seconds to let in-flight replies finish on shutdown

# A long eval sends nothing until it finishes, and the client aborts a call that
# stays silent for too long (Claude Code: 30 min for stdio servers). While a
# routed call is open we therefore emit a progress notification every so often.
PROGRESS_INTERVAL = 60.0     # seconds between progress heartbeats

# Server-level teaser returned from `initialize`, so an agent knows when to reach
# for the Julia REPL even before any REPL exists.
ADAPTER_INSTRUCTIONS = (
    "This server bridges to a warm, persistent Julia REPL. Prefer it over running "
    "`julia` in bash: you skip precompile/startup latency (TTFX) and keep live "
    "state — variables, loaded packages, Revise hot-reload — across calls. Use "
    "`exec_repl` to evaluate Julia code. If no REPL is running you can start your "
